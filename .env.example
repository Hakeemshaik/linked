# On Vercel, set these in Project -> Settings -> Environment Variables (not in a file).
# For npm start / Docker, copy this file to .env. Anything left empty falls back to the local default.

# ---- App ----
APP_NAME=Linkup
APP_TIMEZONE=Africa/Johannesburg
# Friends need this code to create an account. Invite links skip it. Empty = anyone with the URL can sign up.
REGISTRATION_CODE=change-me

# ---- Database ----
# Vercel: add Neon from the Storage tab and this is filled in for you. Empty = embedded database in server/data/.
DATABASE_URL=

# ---- Live chat, typing, presence, call signalling ----
# Vercel: required. Create a Channels app at pusher.com and copy its keys. Empty = local stream (npm start only).
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=eu

# ---- Reminders on time ----
# Vercel: copy QSTASH_TOKEN (and QSTASH_URL if the console shows one) from console.upstash.com -> QStash.
# Without it, reminders only go out when someone has the app open, or at the daily sweep. npm start uses a timer.
QSTASH_TOKEN=
QSTASH_URL=
# Optional: Vercel sends this to the daily cron. Any long random string.
CRON_SECRET=

# ---- Planner AI (any OpenAI-compatible server: Ollama, LM Studio, llama.cpp, vLLM) ----
# Vercel, Ollama on your PC: https://<your-pc>.<tailnet>.ts.net/v1 (see README, "Planner on your PC")
# npm start on the same PC as Ollama: http://localhost:11434/v1
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:7b
# With the Ollama gate this must be a long random secret, the same on the PC and on Vercel.
LLM_API_KEY=ollama
LLM_TIMEOUT_MS=180000
# Set to false if your server rejects response_format=json_object
LLM_JSON_MODE=true

# ---- Push notifications ----
# Keys are generated on first run and kept in the database. Only set them to bring existing keys along.
VAPID_SUBJECT=mailto:you@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ---- Video calls: optional TURN relay (needed when a friend is on a strict mobile network) ----
# TURN_URL=turn:your-turn-host:3478,turns:your-turn-host:5349
# TURN_USERNAME=
# TURN_PASSWORD=

# ---- Only for npm start / Docker ----
PORT=8080
# If the app is hosted on a different site than the API, list that site here, comma-separated. Empty = allow any.
CORS_ORIGIN=
# Optional fixed secret for login tokens (otherwise generated and kept in the database)
JWT_SECRET=
