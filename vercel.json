{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "web/dist",
  "framework": null,
  "regions": ["iad1"],
  "functions": {
    "api/index.js": { "maxDuration": 300, "excludeFiles": "server/node_modules/@electric-sql/**" }
  },
  "crons": [{ "path": "/api/cron/reminders", "schedule": "0 4 * * *" }],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/((?!api/|api$|assets/|icons/|art/|sw\\.js|version\\.json|manifest\\.webmanifest).*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }, { "key": "Service-Worker-Allowed", "value": "/" }] },
    { "source": "/index.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/version.json", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/art/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] },
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
